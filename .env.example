# Local-only by default. Copy to .env and chmod 600 .env.
PORT=4640
REGISTRY_PORT=4641
TASKDOCK_DATA_DIR=.data
TASKDOCK_REGISTRY_URL=http://127.0.0.1:4641
# Set your own key; do not put credentials into task manifests.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Required if changing HOST away from loopback; clients use Authorization: Bearer.
# TASKDOCK_API_TOKEN=
# Independent registry authentication, required for non-loopback registry hosting.
# TASKDOCK_REGISTRY_TOKEN=
